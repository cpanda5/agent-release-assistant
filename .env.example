# LLM (DashScope)
DASHSCOPE_API_KEY=sk-...
LLM_BASE_URL=https://llm-6qoqdsrsqplw1w8w.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL=qwen3.7-flash
# 可选模型：qwen3.7-flash（快） / qwen3.7-plus（均衡） / qwen3.7-max（最强）
DEFAULT_MODEL=qwen3.7-flash
FALLBACK_MODEL=qwen3.7-plus
MAX_TOKENS=5000
ENABLE_THINKING=false
DEBUG=false

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=agent_release

# Auth (login / register / Bearer token)
AUTH_SECRET_KEY=dev-se**ret-change-me
TOKEN_EXPIRE_HOURS=72

# RAG — SiliconFlow (embeddings + rerank)
SILICONFLOW_API_KEY=sk-...
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DIM=1024

# RAG — Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agent_knowledge

# RAG — MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=knowledge-docs

# RAG — chunking / retrieval
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_RERANK_TOP_N=20
